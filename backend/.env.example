DATABASE_URL=postgresql://campusmeetup:campusmeetup@localhost:5432/campusmeetup
JWT_SECRET_KEY=change-this-to-a-random-secret-in-your-own-.env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOADS_DIR=uploads
MICROSOFT_CLIENT_ID=jouw-azure-app-client-id
# Genereren met: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGE_ENCRYPTION_KEY=change-this-to-your-own-generated-fernet-key
# Optioneel: zonder key blijft de app werken, meldingsmails worden dan gewoon niet verstuurd.
# Eigen (gratis) account + "Sending access"-key aanmaken op https://resend.com
RESEND_API_KEY=
# Sandbox-afzender, werkt zonder domeinverificatie — overschrijf met je eigen geverifieerde domein indien gewenst
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173
# Komma-gescheiden lijst, bv. https://campusmeetup.site,https://www.campusmeetup.site
ALLOWED_ORIGINS=http://localhost:5173
